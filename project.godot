; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mindkeep"
run/main_scene="res://scenes/meniu/meniu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Muzica="*res://autoload/muzica.gd"
Sunet="*res://autoload/sunet.gd"
Fereastra="*res://autoload/fereastra.gd"
Tezaur="*res://autoload/tezaur.gd"
Sac="*res://autoload/sac.gd"
Discipline="*res://autoload/discipline.gd"
Expeditie="*res://autoload/expeditie.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=3
rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_2d=1
