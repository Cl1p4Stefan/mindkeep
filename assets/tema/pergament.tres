Button/colors/font_pressed_color = Color(0.12, 0.07, 0.03, 1)
; Iconițele sunt imagini COLORATE (PNG pictate, ca figurina de pe hartă), deci
; tema nu le mai vopsește: albul lasă culorile cum sunt. Survolate se
; luminează puțin (peste 1 = mai luminos); stinse, se estompează ca textul.
Button/colors/icon_disabled_color = Color(1, 1, 1, 0.35)
Button/colors/icon_focus_color = Color(1, 1, 1, 1)
Button/colors/icon_hover_color = Color(1.15, 1.15, 1.15, 1)
Button/colors/icon_hover_pressed_color = Color(0.85, 0.85, 0.85, 1)
Button/colors/icon_normal_color = Color(1, 1, 1, 1)
Button/colors/icon_pressed_color = Color(0.85, 0.85, 0.85, 1)
Button/styles/disabled = SubResource("StyleBoxFlat_buton_stins")
Button/styles/focus = SubResource("StyleBoxFlat_buton_focus")
Button/styles/hover = SubResource("StyleBoxFlat_buton_hover")
Button/styles/hover_pressed = SubResource("StyleBoxFlat_buton_apasat")
Button/styles/normal = SubResource("StyleBoxFlat_buton")
Button/styles/pressed = SubResource("StyleBoxFlat_buton_apasat")
Label/colors/font_color = Color(0.2, 0.12, 0.06, 1)
PanelContainer/styles/panel = SubResource("StyleBoxFlat_pagina")
; Culorile de verdict ale lui `puzzle.gd` (vezi `_culoare()` acolo). Se
; ÎNMULȚESC cu fondul stins al butonului (0.88, 0.8, 0.64), deci s-au ales
; după produs: verde de cerneală veche și roșu de rubrică, nu de semafor.
