[gd_resource type="Theme" format=3]

; TEMA PERGAMENT — hârtie, cerneală și rubrică, în culorile hărții de expediție.
; Se pune pe RĂDĂCINA unei scene (`theme = ...`) și coboară singură în tot
; arborele, inclusiv în scenele instanțiate dedesubt (trivia din Practice).
; De ce și cum se folosește: antetul `ÎMBRĂCĂMINTEA` din `practice.gd`.
;
; ATENȚIE: comentariile cu `;` dispar dacă tema se salvează din editor.
; Explicația care contează stă în `practice.gd`, nu aici.

[ext_resource type="FontFile" path="res://assets/fonturi/Alegreya.ttf" id="1_alegreya"]
[ext_resource type="FontFile" path="res://assets/fonturi/Cinzel.ttf" id="2_cinzel"]

; Fonturile sunt VARIABILE: un singur fișier ține toate grosimile, iar
; `variation_opentype` alege una. Cheia 2003265652 e eticheta „wght” scrisă
; ca număr (0x77676874), așa cum o salvează Godot.
[sub_resource type="FontVariation" id="FontVariation_text"]
base_font = ExtResource("1_alegreya")
variation_opentype = {
2003265652: 500
}

[sub_resource type="FontVariation" id="FontVariation_titlu"]
base_font = ExtResource("2_cinzel")
variation_opentype = {
2003265652: 700
}

; PAGINA: panoul de pergament, cu umbră, ca o foaie pusă pe masă.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_pagina"]
content_margin_left = 6.0
content_margin_top = 6.0
content_margin_right = 6.0
content_margin_bottom = 6.0
bg_color = Color(0.91, 0.84, 0.69, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.34, 0.22, 0.12, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
shadow_color = Color(0, 0, 0, 0.55)
shadow_size = 18
shadow_offset = Vector2(0, 6)

